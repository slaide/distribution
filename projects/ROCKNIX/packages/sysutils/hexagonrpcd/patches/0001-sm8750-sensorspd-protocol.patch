+/* write-sink: discards everything, reads back empty */
+int hexagonfs_open_null(struct hexagonfs_fd **fds)
+{
+	struct hexagonfs_fd *fd;
+	int ret;
+
+	fd = malloc(sizeof(struct hexagonfs_fd));
+	if (fd == NULL)
+		return -ENOMEM;
+
+	fd->up = NULL;
+	fd->data = NULL;
+	fd->ops = &hexagonfs_null_ops;
+
+	ret = allocate_file_number(fds, fd);
+	if (ret < 0)
+		free(fd);
+
+	return ret;
+}
