+/*
+ * Real write support: the sensor PD persists registry state (entry rewrites
+ * via fstempfile + rename, version stamps, debug dumps). Map the DSP-visible
+ * persist paths into the served-files root so later reads through hexagonfs
+ * see what was written. Unmappable write paths fall back to a null sink.
+ */
+#define WRITE_FD_BASE 0x10000
