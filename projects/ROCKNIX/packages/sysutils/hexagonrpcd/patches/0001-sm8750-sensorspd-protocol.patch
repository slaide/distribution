+
+/* maps a DSP path to a host path for writing; returns false if unmapped */
+static bool map_write_path(const char *path, char *out, size_t n)
+{
+	const char *reg_inner = "sensors/registry/registry/";
+	const char *reg_top = "sensors/registry/";
+	const char *sensors_top = "sensors/";
+	const char *p;
+
+	if (apps_std_write_root == NULL)
+		return false;
+
+	p = strstr(path, "/persist/");
+	if (p == NULL)
+		return false;
+	p += strlen("/persist/");
+
+	if (!strncmp(p, reg_inner, strlen(reg_inner)))
+		snprintf(out, n, "%s/sensors/registry/%s", apps_std_write_root,
+			 p + strlen(reg_inner));
+	else if (!strncmp(p, reg_top, strlen(reg_top)))
+		snprintf(out, n, "%s/sensors/registry-state/%s", apps_std_write_root,
+			 p + strlen(reg_top));
+	else if (!strncmp(p, sensors_top, strlen(sensors_top)))
+		snprintf(out, n, "%s/sensors/registry-state/%s", apps_std_write_root,
+			 p + strlen(sensors_top));
+	else
+		return false;
+
+	return true;
+}
+
+static int write_fd_alloc(struct apps_std_ctx *ctx, int hostfd)
+{
+	int i;
+
+	for (i = 0; i < HEXAGONFS_MAX_FD; i++) {
+		if (ctx->write_fds[i] < 0) {
+			ctx->write_fds[i] = hostfd;
+			return WRITE_FD_BASE + i;
+		}
+	}
+
+	return -1;
+}
+
+static int *write_fd_get(struct apps_std_ctx *ctx, uint32_t fd)
+{
+	if (fd < WRITE_FD_BASE || fd >= WRITE_FD_BASE + HEXAGONFS_MAX_FD)
+		return NULL;
+	if (ctx->write_fds[fd - WRITE_FD_BASE] < 0)
+		return NULL;
+	return &ctx->write_fds[fd - WRITE_FD_BASE];
+}
