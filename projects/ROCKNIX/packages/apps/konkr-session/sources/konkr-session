# Persistent gamescope session compositor for SM8750 (KONKR). One gamescope owns
# the DRM display for the whole session and hosts the frontend (and, later, Steam
# and emulators) as its clients -- the Steam Deck "gamescope-session" model. This
# replaces sway as the session compositor and is selected by
# system.compositor=gamescope (see the SM8750 090-ui_service quirk); the sway
# path stays as the fallback.
#
# gamescope's fixed virtual output decouples the client from the physical
# connector, so a display hotplug just re-scans-out (no zero-output gap) and the
# frontend cannot wedge the way it did being juggled by sway + output_monitor.
source /etc/profile

export HOME="${HOME:-/storage}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/var/run/0-runtime-dir}"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 700 "${XDG_RUNTIME_DIR}"

# Session dbus (pipewire / portals expect one), mirroring sway.sh.
[ -S "${XDG_RUNTIME_DIR}/bus" ] || \
  dbus-daemon --session --address="unix:path=${XDG_RUNTIME_DIR}/bus" &

# --- Output selection: the built-in panel, or an attached external display when
# preferred (system.external_display). Same policy as the Steam launcher; the
# fixed logical resolution is native on both the panel (1080x1920 rotated ==
# 1920x1080 effective) and a 1080p external. ---
# List EVERY external connector that exists (the /sys node is present even while
# disconnected) ahead of the internal panel when the user prefers external
# output. gamescope re-evaluates --prefer-output on hotplug, so with the external
# already in the list it auto-migrates onto a display the moment it is plugged
# and falls back to DSI-1 on unplug -- no session restart, no output_monitor.
# pref=ignore leaves the externals out entirely, so a plugged cable is a no-op
# (internal only); switching that preference is applied by restarting the session
# (device-controls does this) since --prefer-output is fixed at gamescope start.
ext_list=""
for s in /sys/class/drm/card*-DP-*/status \
         /sys/class/drm/card*-HDMI-A-*/status \
         /sys/class/drm/card*-DisplayPort-*/status; do
  [ -f "$s" ] || continue
  name="$(basename "$(dirname "$s")")"; name="${name#card*-}"
  ext_list="${ext_list}${name},"
done
pref="$(get_setting system.external_display 2>/dev/null)"; [ -n "$pref" ] || pref="external"
if [ "$pref" = "external" ] && [ -n "$ext_list" ]; then
  PREFER_OUTPUT="--prefer-output ${ext_list}DSI-1"
else
  PREFER_OUTPUT="--prefer-output DSI-1"
fi

# NOTE: the frame-rate cap (system.fps_limit) is NOT a gamescope startup flag --
# --framerate-limit is reset to 0 by gamescope's dynamic refresh-cycle update, so
# it never sticks. The cap is applied at runtime via `gamescopectl
# debug_set_fps_limit` once the compositor is up: konkr-session-client sets it on
# session start and device-controls changes it live. See konkr-session-client.

# The built-in panel is portrait-mounted (KONKR: sway "transform 90" == gamescope
# "right"). --force-orientation only affects gamescope's *internal* screen type,
# so it is harmless on the landscape external. --use-rotation-shader: this DPU
# can't hardware-rotate. --force-composition: it also can't direct-scan-out
# across an output switch.
#
# -e (Steam integration) is the Steam Deck model: it enables the Steam
# overlay/QAM, mangoapp (--mangoapp), and appid-based focus stacking that brings
# a Steam-launched game (on the 2nd Xwayland -- gamescope exports
# STEAM_GAME_DISPLAY_0=:1) forward over the Steam UI. Under -e steamcompmgr only
# focuses a window whose STEAM_GAME appid is listed in the root
# GAMESCOPECTRL_BASELAYER_APPID (appID==0 windows are not even focusable), so it
# shows nothing until a baselayer is claimed. Our non-Steam frontend claims it:
# konkr-launcher gamescope_register_baselayer() sets STEAM_GAME on its window +
# the root baselayer to a synthetic appid. Steam takes the baselayer over while
# it runs (games layer on top); the launcher exits on Steam launch and re-asserts
# on its next start. (frontend=es does NOT claim a baselayer -> unsupported under
# this -e session; KONKR ships konkr-launcher.)
exec env -u WAYLAND_DISPLAY gamescope \
  --backend drm --xwayland-count 2 --mangoapp -e \
  ${PREFER_OUTPUT} -W 1920 -H 1080 \
  --force-orientation right --use-rotation-shader --force-composition \
  -- /usr/bin/konkr-session-client
