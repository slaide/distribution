# Baselayer client of the persistent gamescope session (konkr-session): keeps the
# selected frontend alive as a gamescope Xwayland (X11) client for the whole
# session -- the Steam Deck "gamescope-session" model.
#
# Supervisor loop, NOT a single exec: the frontend may exit (konkr-launcher quits
# after launching Steam; an app teardown; a crash) but gamescope must persist.
# gamescope's --child is THIS script, which never exits, so the compositor
# survives the frontend restarting -- each iteration brings the menu straight
# back with no teardown. (The legacy sway path relied on killing gamescope to
# respawn the frontend; here gamescope stays and we just re-run it.)
#
# The frontend comes from system.frontend (es / konkr-launcher), orthogonal to
# system.compositor. SDL_VIDEODRIVER=x11 overrides the global wayland default
# (packages/wayland/compositor/sway/profile.d) so the app attaches to gamescope's
# Xwayland (:0), exactly like the Steam launcher does.
source /etc/profile

export SDL_VIDEODRIVER=x11
unset WAYLAND_DISPLAY

# Apply the frame-rate cap now that the session gamescope is up (we are its
# --child). gamescope's --framerate-limit startup flag does not stick -- its
# dynamic refresh-cycle update resets it to 0 -- so the cap must be set through
# the runtime override (gamescopectl debug_set_fps_limit). system.fps_limit is
# the panel-refresh divisor the device-controls Display tab writes: 144/72/48, or
# "0"/off = uncapped (FIFO still vsyncs to the 144Hz panel). Unset defaults to 72
# so light Steam games don't render ~700fps and roast the fans. device-controls
# changes this live the same way (no session restart).
fps="$(get_setting system.fps_limit 2>/dev/null)"; [ -n "$fps" ] || fps="72"
case "$fps" in ''|off|*[!0-9]*) fps=0 ;; esac
for _ in 1 2 3 4 5; do
  gamescopectl debug_set_fps_limit "$fps" >/dev/null 2>&1 && break
  sleep 0.3
done

while :; do
  case "$(get_setting system.frontend)" in
    konkr-launcher|steam)
      # Boot-straight-to-Steam under the session is future work; the launcher is
      # where Steam is reachable, so both settle on it for now.
      export SDL_VIDEO_X11_WMCLASS="konkr-launcher"
      /usr/bin/konkr-launcher
      ;;
    *)
      export SDL_VIDEO_X11_WMCLASS="emulationstation"
      /usr/bin/emulationstation --log-path /var/log --no-splash
      ;;
  esac
  # Guard against a tight respawn storm if the frontend dies immediately.
  sleep 0.3
done
