arm64: dts: qcom: KONKR add MCU system-button/RGB UART (geni SE5)

Enable the AYANEO MCU/EC UART on qupv3_2 SE5 (@894000, "ttyHS1" on stock
Android). Mainline only defines SE5 as i2c13/spi13; the KONKR wires it as a
2-wire 115200 8N1 UART to the MCU: RX delivers the KONKR/Home/menu/grip
system buttons, TX drives the analog-stick RGB. reg/IRQ(587)/clock(S5)
mirror i2c13; pins (gpio22 TX / gpio23 RX, qup2_se5) from the stock fdt.

---
--- a/arch/arm64/boot/dts/qcom/sm8750-konkr-pf-elite.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-konkr-pf-elite.dts
@@ -837,6 +837,28 @@
  * 'avdd'`). The working Odin 3 enables &qupv3_2 too. Enable the wrapper. */
 &qupv3_2 {
 	status = "okay";
+
+	/* AYANEO MCU/EC UART on geni SE5 @894000 ("ttyHS1" on stock Android).
+	 * Mainline only defines SE5 as i2c13/spi13; the KONKR wires it as a 2-wire
+	 * UART (115200 8N1) to the MCU: RX = KONKR/Home/menu/grip "system" buttons
+	 * (byte-x8 + 64 02 frames), TX = analog-stick RGB (F7 01 R G B .. ED).
+	 * reg/IRQ/clock identical to i2c13; pins/func from the stock fdt
+	 * (qup2_se5: gpio22 TX, gpio23 RX). */
+	uart_mcu: serial@894000 {
+		compatible = "qcom,geni-uart";
+		reg = <0x0 0x00894000 0x0 0x4000>;
+		interrupts = <GIC_SPI 587 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&gcc GCC_QUPV3_WRAP2_S5_CLK>;
+		clock-names = "se";
+		interconnects = <&clk_virt MASTER_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS
+				 &clk_virt SLAVE_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS>,
+				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
+				 &config_noc SLAVE_QUP_2 QCOM_ICC_TAG_ALWAYS>;
+		interconnect-names = "qup-core", "qup-config";
+		pinctrl-0 = <&qup_uart_mcu_default>;
+		pinctrl-names = "default";
+		status = "okay";
+	};
 };
 
 /* GENI GPI DMA controllers — geni_i2c on some SEs has the FIFO interface
@@ -1058,6 +1080,14 @@
 	 * them. */
 	gpio-reserved-ranges = <40 4>, <74 1>;
 
+	/* MCU UART (geni SE5, 2-wire): TX gpio22, RX gpio23 */
+	qup_uart_mcu_default: qup-uart-mcu-default-state {
+		pins = "gpio22", "gpio23";
+		function = "qup2_se5";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
 	/* Panel-power master enable. The stock panel node declares
 	 * qcom,platform-en-gpio = <0x26 0xa3 0x0> = TLMM163, the panel-power MASTER
 	 * enable; the SM8650 Konkr (same ar14 panel, working) holds its equivalent
